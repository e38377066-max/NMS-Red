# Copia local creada por npm run local:setup. No subir .env.local a GitHub.
DATABASE_URL=postgresql://isp_cockpit_app:CHANGE_ME@127.0.0.1:5432/isp_cockpit
SESSION_SECRET=__SESSION_SECRET__

# Se crea solo al instalar por primera vez; elimínalo después del primer inicio de sesión.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=__INITIAL_ADMIN_PASSWORD__

PORT=5000
NODE_ENV=production

# Copias y adjuntos se guardan localmente en data/ y no se suben a Git.
BACKUP_STORAGE_PROVIDER=filesystem
BACKUP_STORAGE_DIR=__BACKUP_STORAGE_DIR__
TICKET_ATTACHMENT_STORAGE_DIR=__TICKET_ATTACHMENT_STORAGE_DIR__

MIKROTIK_API_SCHEME=https
MIKROTIK_API_PORT=443
JSON_BODY_LIMIT=4mb