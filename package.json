{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "node scripts/run-local.mjs build",
    "build:web": "node scripts/run-local.mjs build-web",
    "dev": "node scripts/run-local.mjs dev",
    "start": "node scripts/run-local.mjs start",
    "test": "node scripts/run-local.mjs test",
    "local:setup": "node scripts/run-local.mjs setup",
    "local:start": "node scripts/run-local.mjs local-start",
    "local:update": "node scripts/run-local.mjs update",
    "local:db:init": "node scripts/local-db.mjs init",
    "local:db:push": "node scripts/local-db.mjs push",
    "typecheck:tests": "pnpm exec tsc --noEmit -p tsconfig.tests.json",
    "typecheck:server": "pnpm exec tsc --noEmit -p tsconfig.server.json",
    "typecheck:client": "pnpm --filter @workspace/client run typecheck",
    "typecheck:workspace": "pnpm run typecheck:libs && pnpm -r --filter \"./scripts\" --if-present run typecheck",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm run typecheck:client && pnpm run typecheck:server && pnpm run typecheck:workspace",
    "cap:sync": "node scripts/validate-capacitor-api.mjs && pnpm run build:web && pnpm exec cap sync",
    "cap:open:android": "pnpm exec cap open android",
    "cap:open:ios": "pnpm exec cap open ios"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "pino-pretty": "13.1.3",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "node-ssh": "^13.2.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "tsx": "catalog:"
  }
}
