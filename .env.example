# Required application settings
DATABASE_URL=postgresql://user:password@db.example.com:5432/isp_cockpit
SESSION_SECRET=replace-with-at-least-32-random-characters
# Set these only for the first start on an empty database, then remove them.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=8080
NODE_ENV=production
CORS_ORIGINS=https://panel.example.com
JSON_BODY_LIMIT=4mb

# Network access. In production RouterOS REST must be exposed through
# WireGuard, a private network, or a site connector; do not expose it openly.
MIKROTIK_API_SCHEME=https
MIKROTIK_API_PORT=443

# Backup storage. Choose exactly one provider.
# S3 works with AWS S3, MinIO, Cloudflare R2, Backblaze B2, and other
# S3-compatible services.
BACKUP_STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=isp-cockpit-backups

# For a single-server installation instead of S3:
# BACKUP_STORAGE_PROVIDER=filesystem
# BACKUP_STORAGE_DIR=/var/lib/isp-cockpit/backups